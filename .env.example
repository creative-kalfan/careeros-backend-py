# ---- Supabase project credentials (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Optional debug ----
AUTH_DEBUG_ENABLED=false

# ---- Redis / ARQ background worker (Redis-protocol backend) ----
# Local development (unauthenticated, plain TCP):
REDIS_URL=redis://localhost:6379
#
# Production — authenticated + TLS where the provider requires it. ARQ's
# RedisSettings.from_dsn() parses the full DSN, so the `rediss://` scheme
# enables TLS and `user:password@` supplies credentials. Credentials are
# never hard-coded; always inject REDIS_URL from the deployment environment.
#   REDIS_URL=rediss://<username>:<password>@<host>:<port>/0
#
# Aiven Valkey (free tier, no credit card): copy the Service URI from the
# Aiven Console and paste it verbatim — `valkey(s)://` schemes are mapped
# to `redis(s)://` automatically (see normalize_redis_dsn). Aiven uses
# browser-recognized (Let's Encrypt) certificates, so no CA bundle is
# needed; the Docker image already ships ca-certificates.
#   REDIS_URL=valkeys://default:<password>@<host>:<port>/0
# Free-tier notes: single node, 1 GB RAM (maxmemory 50%). ARQ payloads here
# are tiny (job args + small status JSON), so memory pressure is a non-issue.
# Dispatcher targets Aiven Valkey; worker poll defaults to 2s via
# ARQ_POLL_DELAY. Set higher on request-billed Redis plans if needed.
# On non-metered Valkey you may keep the 2s default for faster
# job pickup (backend + worker must share the same REDIS_URL).
#
# Managed providers needing a custom CA bundle / client certificates can be
# configured in app/workers/settings.py (RedisSettings ssl_* options).
#
# ---- Durable crawl scheduler / worker ----
DISPATCH_TICK_SECONDS=60
DISPATCH_BATCH=2
CRAWL_LEASE_SECONDS=900
# How often the crawl dispatcher re-probes the crawl_targets table, so applying
# migration 025 after deploy re-enables dispatch without restarting the service.
MIGRATION_PROBE_RECHECK_SECONDS=300
CRAWL_DEAD_AFTER_FAILURES=10
CRAWL_MIN_INTERVAL_MINUTES=360
CRAWL_MAX_INTERVAL_MINUTES=2880
LEGACY_APSCHEDULER_ENABLED=false
RUN_SCHEDULER_IN_WEB=false
# worker = ARQ worker loops the dispatcher; github = GitHub Actions cron calls
# POST /internal/scheduler/crawl-tick and the worker only consumes jobs.
CRAWL_SCHEDULER_MODE=worker
# Bearer secret for the crawl-tick endpoint (web service). Empty disables it.
SCHEDULER_TRIGGER_SECRET=
ARQ_POLL_DELAY=2
ARQ_CONNECT_TIMEOUT=5
# Default false. Leave false on Render worker services: start.sh already binds $PORT.
# Set true ONLY when running the ARQ worker directly (python -m arq
# app.workers.settings.WorkerSettings, no start.sh) and you need a JSON health endpoint.
WORKER_HTTP_HEALTH=false
DISCOVERY_MAX_PROBES_PER_DAY=50
SLO_OVERDUE_MINUTES=120
ADMIN_STATUS_TOKEN=
ALERT_WEBHOOK_URL=
HEARTBEAT_URL=
JOB_MISS_THRESHOLD=2
ATS_FETCH_CONCURRENCY=10
ATS_CONNECT_TIMEOUT_SECONDS=5
ATS_READ_TIMEOUT_SECONDS=20

# Crawl concurrency-lock TTL in seconds (must exceed max crawl duration)
CRAWL_LOCK_TTL_SECONDS=300
# Legacy ARQ worker queue-poll setting in seconds (superseded by ARQ_POLL_DELAY).
# Each poll is one
# ZRANGEBYSCORE: 0.5s ~= 5.2M req/month (exceeds request-billed budgets 10x),
# 10s ~= 259k req/month (safe on metered plans, negligible on Valkey).
# Lower only for local dev or non-metered backends.
# ARQ_POLL_DELAY_SECONDS=10

# ---- LLM Gateway (backend-only; empty key = provider unconfigured) ----
# LLM_DEFAULT_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GOOGLE_GEMINI_API_KEY=
# GOOGLE_GEMINI_MODEL=gemini-2.0-flash
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Job lifecycle / staleness ----
# Jobs not seen (or posted) within this many days are deactivated.
# JOB_STALE_AFTER_DAYS=30

# ---- Scheduled job-refresh orchestration ----
# Master switch for the scheduled crawl runner (runs inside the FastAPI
# process and enqueues ARQ jobs; the ARQ worker + Redis must be running for
# crawls to actually execute: `python -m arq app.workers.main`).
# JOB_CRAWL_ENABLED=true
# YC Work at a Startup (priority 1 source):
# YC_CRAWL_ENABLED=true
# YC_CRAWL_INTERVAL_HOURS=24
# Firecrawl official company career pages (priority 2 source):
# FIRECRAWL_ENABLED=true
# FIRECRAWL_CRAWL_INTERVAL_HOURS=24
# Direct official ATS boards (priority 3):
# ATS_CRAWL_INTERVAL_HOURS=24
# Aggregators (priority 4, least frequent):
# AGGREGATOR_CRAWL_INTERVAL_HOURS=24
# Legacy single-interval override (wins over all per-provider intervals):
# CRAWL_INTERVAL_HOURS=24
#
# Crawl targets are registered in app/crawlers/crawl_registry.py — add
# companies there (YC, Firecrawl career URLs, ATS boards, Adzuna/JobSpy queries).

# ---- Adzuna India (free-tier friendly: ~5 calls/crawl/day ≈ 150/month) ----
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_QUERIES_PER_CRAWL=2
# ADZUNA_RESULTS_PER_PAGE=50

# ---- JobSpy broad discovery layer (python-jobspy==1.1.82) ----
# Bounded rotation: each scheduled run executes only
# max(JOBSPY_QUERY_BATCH_SIZE, JOBSPY_LOCATION_BATCH_SIZE) + 1 searches —
# never the full query matrix simultaneously. Crawl cadence follows
# AGGREGATOR_CRAWL_INTERVAL_HOURS (no second scheduler).
# JOBSPY_ENABLED=true
# JOBSPY_RESULTS_WANTED=50
# JOBSPY_TIMEOUT_SECONDS=60
# Provider allowlist (subset of indeed,naukri,glassdoor,linkedin).
# Indeed = broad recurring searches; Naukri = India-specific coverage;
# LinkedIn = conservative (longer delay, rate-limit sensitive).
# JOBSPY_SITES=indeed,naukri,linkedin
# JOBSPY_MAX_CONCURRENT=2
# JOBSPY_PER_PROVIDER_DELAY_SECONDS=5
# JOBSPY_LINKEDIN_DELAY_SECONDS=15
# JOBSPY_QUERY_BATCH_SIZE=4
# JOBSPY_LOCATION_BATCH_SIZE=2
# Freshness buckets (hours_old rotation: very recent / recent / rolling).
# JOBSPY_FRESHNESS_BUCKETS=24,72,168
# JOBSPY_PROVIDER_COOLDOWN_SECONDS=600
# JOBSPY_CIRCUIT_THRESHOLD=3
# JOBSPY_SEARCH_CACHE_TTL_HOURS=24

# ---- Firecrawl (official company career-page ingestion; backend-only) ----
# Optional: when unset, Firecrawl crawling is disabled and any attempt to use
# it fails with a clear configuration error (never a fake success).
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v1
# FIRECRAWL_TIMEOUT_SECONDS=30
# FIRECRAWL_MAX_RETRIES=3
# FIRECRAWL_MAX_PAGES_PER_CRAWL=15

# ---- Resume upload guard (bytes) ----
# Files larger than this are rejected before expensive parsing (default 10 MB).
# MAX_RESUME_UPLOAD_BYTES=10485760

# ---- Friendly batch evidence discovery (resume tailoring) ----
# Maximum improvement opportunities surfaced in ONE collective candidate
# interaction (default 5, hard cap 6). Per-request maxOpportunities wins.
# TAILORING_MAX_OPPORTUNITIES=5

# ---- Test credentials (required to run tests/test_auth.py) ----
# A regular (non-admin) user that exists in the Supabase project.
TEST_USER_EMAIL=test-user@example.com
TEST_USER_PASSWORD=test-password

# An admin user (profiles.role == 'admin') that exists in the Supabase project.
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=admin-password
